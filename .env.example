# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/skysync?retryWrites=true&w=majority
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/skysync?retryWrites=true&w=majority"

# JWT Secret Key used for signing and verifying tokens
JWT_SECRET="skysync_super_secure_jwt_secret_key_change_in_production_123456"

# OpenWeatherMap API Key (Free tier available at https://home.openweathermap.org/api_keys)
WEATHER_API_KEY="your_openweathermap_api_key_here"

# Server Port (Defaults to 3000)
PORT=3000

# GEMINI_API_KEY: Optional/Default injected by environment
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
